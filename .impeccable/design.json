  "narrative": {
    "northStar": "Rumah Terbuka",
    "overview": "A welcoming, daylight-filled room becomes the visual metaphor for catering with the familiarity of home. Continuous material sections, tall italic headings, and photographs at different scales create an open architectural rhythm rather than a collection of floating cards.\n\nThe built system is warm, direct, and professional. Food, package information, and consultation controls remain legible within the spatial composition. Photographs are explicitly illustrative; visual richness never stands in for evidence about clients, production, or certification. The selected replacement world is not the former green-and-cream identity.",
    "keyCharacteristics": [
      "Continuous limewashed and paper surfaces.",
      "Charcoal structural cuts with a sunbeam light plane.",
      "Self-hosted condensed italic display paired with calm Barlow text.",
      "Square photography and near-square controls.",
      "Honest captions and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Light Plane Rule",
        "body": "Sunbeam connects space and marks action; it is not a decorative gradient or a blanket card background.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Condensed italic carries invitations and major headings; normal Barlow carries decisions, labels, prices, and explanations.",
        "section": "typography"
      },
      {
        "name": "The Continuous Room Rule",
        "body": "Separate information through material changes, measured spacing, and shared dividers before introducing isolated containers.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** use material changes and shared dividers to organize continuous sections.",
      "**Do** use self-hosted condensed italic for major invitations and normal Barlow for operational detail.",
      "**Do** keep image captions and illustration disclosures visible beside their photographs.",
      "**Do** preserve visible focus, pressed states, and reduced-motion behavior.",
      "**Do** follow the final mobile cascade rather than copying superseded declarations."
    ],
    "donts": [
      "**Don't** replace square photo planes with generic rounded, shadowed cards.",
      "**Don't** remove architectural section cuts merely because an automated detector labels them card accents.",
      "**Don't** revive the discarded green-and-cream identity or turn the light plane into a decorative gradient.",
      "**Don't** treat stock imagery as evidence of clients, certification, or actual delivered packages.",
      "**Don't** make the landing page composition a mandatory template for every future surface."
    ]
  }
}
