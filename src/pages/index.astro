---
import '../styles/global.css';
import { photos, heroPhotoId, type Photo } from '../data/photography';
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const hero = photos.find((photo) => photo.id === heroPhotoId)!;
const food = photos.filter((photo) => ['nusantara', 'western', 'asian', 'vegetarian'].includes(photo.category));
const ingredients = photos.filter((photo) => photo.category === 'ingredients');
const packaging = photos.filter((photo) => photo.category === 'packaging');
const occasions = photos.filter((photo) => photo.category === 'occasion');
const heroSecondary = food.find((photo) => photo.id !== heroPhotoId)!;
const heroDetail = ingredients[0] ?? food[2];
const stages = [
  { id: 'menu', label: 'Menu pilihan', photo: hero, caption: 'Rasa yang mengundang untuk berkumpul.' },
  { id: 'kemasan', label: 'Dalam satu kotak', photo: packaging[1], caption: 'Ilustrasi makanan dalam kemasan.' },
  { id: 'acara', label: 'Untuk acara Anda', photo: occasions[0], caption: 'Inspirasi suasana acara, bukan dokumentasi klien.' },
];
const money = (value: number) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(value);
const photoTitle = (photo: Photo) => photo.id.replace(/-/g, ' ').replace(/^./, (letter) => letter.toUpperCase());
const packages = [
  { name: 'Bronze', price: 25000, min: 50, note: 'Sederhana, tetap istimewa.', items: ['Nasi putih', '1 protein utama', '1 sayur, kerupuk & buah', 'Air mineral'], choices: 'Ayam goreng, ayam bakar, atau semur daging.' },
  { name: 'Silver', price: 35000, min: 50, note: 'Lebih banyak rasa untuk dibagi.', items: ['Nasi putih atau uduk', '2 protein pilihan', '1 sayur, kerupuk, buah & dessert', 'Air mineral'], choices: 'Rendang, ayam betutu, atau ikan dori.' },
  { name: 'Gold', price: 50000, min: 50, note: 'Lengkap untuk hari yang penting.', items: ['Nasi putih, uduk, atau kebuli', '3 protein & 2 sayur', 'Lalapan, sambal, buah & dessert premium', 'Air mineral'], choices: 'Rendang sapi, gulai ayam, dendeng balado, atau ikan kakap.' },
  { name: 'Platinum', price: 75000, min: 100, note: 'Jamuan untuk momen spesial.', items: ['Appetizer & 4 protein', 'Main course premium', 'Dessert & fresh fruit', 'Air mineral atau jus'], choices: 'Untuk pernikahan dan corporate executive event.' },
];
const menuCategories = [{ value: 'all', label: 'Semua menu' }, { value: 'nusantara', label: 'Nusantara' }, { value: 'western', label: 'Western' }, { value: 'asian', label: 'Asian Fusion' }, { value: 'vegetarian', label: 'Vegetarian' }];
const occasionCategory = (photo: Photo) => ({ 'acara-taman': 'wedding', 'rapat-kantor': 'corporate', 'belajar-bersama': 'education', 'kumpul-keluarga': 'social' } as Record<string, string>)[photo.id];
const occasionLabels: Record<string, string> = { wedding: 'Pernikahan', corporate: 'Acara kantor', education: 'Pendidikan', social: 'Kumpul keluarga' };
const whatsapp = 'https://wa.me/6282268116531?text=Halo%20Kotak%20Berkah%2C%20saya%20ingin%20konsultasi%20catering.';
const schema = { '@context': 'https://schema.org', '@type': 'FoodEstablishment', name: 'Kotak Berkah Catering', description: 'Catering nasi kotak dengan cita rasa rumahan untuk acara keluarga, kantor, dan pernikahan.', servesCuisine: ['Indonesian', 'Asian', 'Western'], telephone: '+6282268116531', priceRange: 'Rp25.000–Rp75.000 per kotak' };
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2efea" />
    <title>Kotak Berkah Catering | Rasa Rumah untuk Acara Spesialmu</title>
    <meta name="description" content="Pilihan nasi kotak dengan cita rasa rumahan untuk acara keluarga, kantor, dan pernikahan. Bandingkan paket mulai Rp25.000 dan konsultasikan acara melalui WhatsApp." />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content="Kotak Berkah | Rasa Rumah untuk Acara Spesialmu" />
    <meta property="og:description" content="Temukan paket nasi kotak yang pas untuk acara Anda. Mulai Rp25.000 per kotak." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={new URL(asset(hero.src), Astro.site).href} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Kotak Berkah, halaman utama"><span class="brand-mark" aria-hidden="true">kb.</span><span>Kotak Berkah<span class="brand-sub">Catering</span></span></a>
      <nav class="desktop-nav" aria-label="Navigasi utama"><a href="#paket">Paket Menu</a><a href="#kapasitas">Layanan</a><a href="#portfolio">Portfolio</a><a href="#cara-pesan">Cara Pesan</a></nav>
      <div class="header-actions"><a class="button button-small" href="#form">Konsultasi acara</a><button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="mobile-navigation">Menu</button></div>
      <nav id="mobile-navigation" class="mobile-nav" aria-label="Navigasi mobile" hidden><a href="#paket">Paket Menu</a><a href="#menu">Pilihan Menu</a><a href="#kapasitas">Layanan</a><a href="#portfolio">Portfolio</a><a href="#cara-pesan">Cara Pesan</a><a href="#form">Kontak</a></nav>
    </header>
    <main id="main">
      <section id="hero" class="daylight-section" data-stage="menu" aria-labelledby="hero-title">
        <div class="hero-intro"><h1 id="hero-title">Rasa rumah.<br /><em>Acara istimewa.</em></h1><p>Nasi kotak untuk pernikahan, acara kantor, dan syukuran. Pilih menu, ceritakan acara, biarkan kami membantu.</p><div class="hero-action"><a class="button button-sun" href="#paket">Lihat Paket Menu</a><a class="text-link" href={whatsapp} target="_blank" rel="noopener noreferrer">Konsultasi via WhatsApp</a></div></div>
        <div class="hero-space">
          <div class="sun-plane" aria-hidden="true"></div>
          <figure class="hero-main-photo"><img id="stage-photo" src={asset(hero.src)} width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" loading="eager" /><figcaption id="stage-caption">Rasa yang mengundang untuk berkumpul.</figcaption></figure>
          <figure class="hero-side-photo"><img src={asset(heroSecondary.src)} width={heroSecondary.width} height={heroSecondary.height} alt={heroSecondary.alt} loading="eager" /><figcaption>Pilihan lauk</figcaption></figure>
          <figure class="hero-detail-photo"><img src={asset(heroDetail.src)} width={heroDetail.width} height={heroDetail.height} alt={heroDetail.alt} loading="eager" /><figcaption>Detail rasa</figcaption></figure>
          <div class="photo-note">Fotografi menu bersifat ilustratif.</div>
        </div>
        <div class="section-path" role="group" aria-label="Jelajahi kebutuhan acara">{stages.map((stage) => <button type="button" data-light-stage data-stage={stage.id} data-photo-src={asset(stage.photo.src)} data-photo-alt={stage.photo.alt} data-photo-caption={stage.caption} aria-pressed={stage.id === 'menu'}><span class="path-line" aria-hidden="true"></span>{stage.label}</button>)}<div class="path-price"><span>Mulai <strong>Rp25.000</strong> / kotak</span><button type="button" class="text-link" data-select-package="Bronze">Pilih paket awal</button></div></div>
      </section>

      <section id="paket" class="section packages-section" aria-labelledby="packages-title">
        <div class="section-heading"><h2 id="packages-title">Ada paket yang pas<br /><em>untuk setiap meja.</em></h2><p>Empat pilihan untuk kebutuhan berbeda. Semua paket termasuk kemasan, sendok, tisu, dan air mineral.</p></div>
        <div class="package-grid">{packages.map((pack, index) => <article class:list={['package', { 'package-featured': pack.name === 'Silver' }]}>
          <div class="package-top"><h3>{pack.name}</h3><span>{pack.min} kotak minimum</span></div>
          <figure><img src={asset(food[index].src)} width={food[index].width} height={food[index].height} alt={food[index].alt} loading="lazy" /><figcaption>Ilustrasi pilihan menu</figcaption></figure>
          <div class="package-price">{money(pack.price)}<span>per kotak</span></div><p class="package-note">{pack.note}</p><ul>{pack.items.map((item) => <li>{item}</li>)}</ul><p class="package-choices">{pack.choices}</p><button class:list={['button', { 'button-sun': pack.name === 'Silver', 'button-outline': pack.name !== 'Silver' }]} type="button" data-select-package={pack.name}>Pilih {pack.name}</button>
        </article>)}</div>
        <p class="section-footnote">Foto bukan representasi pasti isi setiap paket. Rincian menu dan ongkos kirim dikonfirmasi saat konsultasi.</p>
      </section>

      <section id="menu" class="section menu-section" aria-labelledby="menu-title">
        <div class="section-heading"><h2 id="menu-title">Banyak rasa.<br /><em>Satu selera Anda.</em></h2><p>Dari lauk Nusantara sampai pilihan vegetarian. Jelajahi inspirasinya, lalu sampaikan menu favorit saat konsultasi.</p></div>
        <div class="filter-row" role="group" aria-label="Kategori menu">{menuCategories.map((category) => <button type="button" data-menu-filter={category.value} aria-pressed={category.value === 'all'}>{category.label}</button>)}</div>
        <div class="dish-grid">{food.map((photo, index) => <figure class:list={['dish', { 'dish-wide': index % 7 === 0 }]} data-dish data-category={photo.category}><img src={asset(photo.src)} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async" /><figcaption><h3>{photoTitle(photo)}</h3><span>{menuCategories.find((category) => category.value === photo.category)?.label}</span></figcaption></figure>)}</div>
        <div class="menu-close"><p>Belum menemukan yang cocok?</p><a class="text-link" href={whatsapp} target="_blank" rel="noopener noreferrer">Diskusikan menu custom dengan kami</a><small>Seluruh foto pada eksplorasi menu adalah ilustrasi.</small></div>
      </section>

      <section id="kenapa-kami" class="section ingredients-section" aria-labelledby="ingredients-title">
        <div class="ingredient-intro"><h2 id="ingredients-title">Acara boleh besar.<br /><em>Rasanya tetap dekat.</em></h2><p>Rasa rumah, untuk acara spesialmu. Dari pilihan lauk sampai kebutuhan tamu, setiap detail dapat dibicarakan sebelum Anda menentukan pesanan.</p></div>
        <div class="ingredient-strip">{ingredients.map((photo) => <figure><img src={asset(photo.src)} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" /><figcaption>{photo.alt}</figcaption></figure>)}</div>
        <div class="principles"><p><strong>Menu yang bisa dibicarakan.</strong>Pilihan lauk, selera tamu, dan permintaan khusus disampaikan saat konsultasi.</p><p><strong>Isi paket yang jelas.</strong>Bandingkan protein, sayur, pelengkap, dan harga sebelum memilih.</p><p><strong>Acara Anda yang jadi acuan.</strong>Tanggal, jumlah kotak, lokasi, dan anggaran membantu menyiapkan penawaran.</p></div>
      </section>

      <section id="kapasitas" class="section service-section" aria-labelledby="service-title">
        <div class="service-copy"><h2 id="service-title">Dalam satu kotak,<br /><em>untuk banyak momen.</em></h2><p>Dari acara keluarga hingga kebutuhan kantor. Sampaikan jumlah tamu dan lokasi, kami bantu membicarakan paket yang sesuai.</p><dl class="service-facts"><div><dt>Minimum pesanan</dt><dd>50 kotak standar<br />100 kotak Platinum</dd></div><div><dt>Waktu booking</dt><dd>H-3 paket standar<br />H-7 paket Platinum</dd></div><div><dt>Area layanan</dt><dd>Jabodetabek & Bandung<br /><small>Rute dan ongkir dikonfirmasi admin.</small></dd></div></dl><a class="text-link" href="#form">Ceritakan kebutuhan acara Anda</a></div>
        <div class="packaging-space">{packaging.map((photo) => <figure><img src={asset(photo.src)} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" /><figcaption>{photo.alt} · ilustrasi</figcaption></figure>)}<p class="packaging-caption">Pilihan kemasan aktual mengikuti paket dan hasil konsultasi.</p></div>
      </section>

      <section id="portfolio" class="section occasion-section" aria-labelledby="occasion-title">
        <div class="section-heading"><h2 id="occasion-title">Ada cerita<br /><em>di setiap pertemuan.</em></h2><p>Inspirasi untuk pernikahan, rapat, seminar, dan kumpul keluarga. Foto berikut menggambarkan suasana acara, bukan dokumentasi klien Kotak Berkah.</p></div>
        <div class="filter-row" role="group" aria-label="Jenis acara">{[{ value: 'all', label: 'Semua acara' }, { value: 'wedding', label: 'Wedding' }, { value: 'corporate', label: 'Corporate' }, { value: 'education', label: 'Pendidikan' }, { value: 'social', label: 'Keluarga & sosial' }].map((filter) => <button type="button" data-gallery-filter={filter.value} aria-pressed={filter.value === 'all'}>{filter.label}</button>)}</div>
        <div class="occasion-grid">{occasions.map((photo, index) => <figure class:list={['occasion', { 'occasion-wide': index === 0 }]} data-gallery-item data-category={occasionCategory(photo)}><img src={asset(photo.src)} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" /><figcaption><h3>{occasionLabels[occasionCategory(photo)]}</h3><span>Inspirasi suasana acara</span></figcaption></figure>)}</div>
      </section>

      <section id="testimonial" class="section gathering-note" aria-labelledby="gathering-title"><h2 id="gathering-title">Yang dirayakan bukan cuma acaranya.<br /><em>Tapi kebersamaannya.</em></h2><p>Untuk meja rapat yang penuh ide, keluarga yang kembali berkumpul, dan hari istimewa yang ingin dikenang.</p><a class="text-link" href="#form">Mari siapkan konsumsi acaranya</a></section>

      <section id="cara-pesan" class="section steps-section" aria-labelledby="steps-title"><div class="section-heading"><h2 id="steps-title">Dari obrolan pertama,<br /><em>sampai hari acara.</em></h2><p>Empat langkah untuk menyamakan kebutuhan sebelum pesanan disiapkan.</p></div><ol class="order-steps"><li><span>1</span><h3>Konsultasi</h3><p>Sampaikan tanggal, lokasi, jumlah kotak, dan pilihan menu melalui WhatsApp.</p></li><li><span>2</span><h3>Penawaran</h3><p>Admin membantu merinci paket, menu, pengiriman, dan total biaya.</p></li><li><span>3</span><h3>Konfirmasi</h3><p>DP 30% sesuai penawaran untuk mengonfirmasi pesanan.</p></li><li><span>4</span><h3>Hari acara</h3><p>Pengiriman mengikuti jadwal dan lokasi yang telah disepakati.</p></li></ol></section>

      <section class="section faq-section" aria-labelledby="faq-title"><h2 id="faq-title">Sebelum Anda<br /><em>menentukan pilihan.</em></h2><div class="faq-list"><details><summary>Berapa minimum pemesanannya?</summary><p>Bronze, Silver, dan Gold mulai 50 kotak. Platinum mulai 100 kotak. Sampaikan jumlah yang Anda butuhkan saat konsultasi.</p></details><details><summary>Kapan sebaiknya melakukan booking?</summary><p>Siapkan pemesanan setidaknya H-3 untuk paket standar dan H-7 untuk Platinum. Ketersediaan tanggal tetap perlu dikonfirmasi admin.</p></details><details><summary>Apakah bisa memilih menu sendiri?</summary><p>Pilihan lauk dan menu custom dapat didiskusikan. Sertakan selera tamu, kebutuhan vegetarian, atau alergi pada catatan. Admin akan mengonfirmasi kemungkinan pemenuhannya.</p></details><details><summary>Apakah harga sudah termasuk ongkos kirim?</summary><p>Harga paket di halaman ini adalah harga makanan per kotak. Rute pengiriman, ongkir, dan ketentuan tambahan dikonfirmasi dalam penawaran.</p></details><details><summary>Apakah formulir ini langsung memesan?</summary><p>Tidak. Formulir membuka WhatsApp dengan ringkasan kebutuhan Anda. Pesanan baru dikonfirmasi setelah penawaran dan ketentuan pembayaran disepakati.</p></details></div></section>

      <section id="form" class="section inquiry-section" aria-labelledby="inquiry-title"><div class="inquiry-intro"><h2 id="inquiry-title">Acara Anda<br /><em>dimulai dari sini.</em></h2><p>Ceritakan kebutuhannya. Kami bantu menemukan paket yang pas.</p><div class="estimate-box"><span>Estimasi biaya makanan</span><strong data-estimate>Rp1.750.000</strong><p data-minimum>Minimum 50 kotak</p><small>Belum termasuk ongkos kirim. Bukan penawaran final atau konfirmasi booking.</small></div><a class="text-link" href={whatsapp} target="_blank" rel="noopener noreferrer">Lebih nyaman ngobrol langsung?</a></div>
        <form id="inquiry" class="inquiry-form" action="https://wa.me/6282268116531" method="get" target="_blank"><div class="form-fields"><div class="field"><label for="nama">Nama lengkap</label><input id="nama" name="nama" type="text" autocomplete="name" placeholder="Nama Anda" required /></div><div class="field"><label for="whatsapp">Nomor WhatsApp</label><input id="whatsapp" name="whatsapp" type="tel" autocomplete="tel" placeholder="08xx atau +62" required /></div><div class="field"><label for="tanggal">Tanggal acara</label><input id="tanggal" name="tanggal" type="date" required /></div><div class="field"><label for="jumlah">Jumlah kotak</label><input id="jumlah" name="jumlah" type="number" min="50" step="1" value="50" inputmode="numeric" required /></div><div class="field"><label for="paket-choice">Pilihan paket</label><select id="paket-choice" name="paket" required>{packages.map((pack) => <option value={pack.name} selected={pack.name === 'Silver'}>{pack.name} · {money(pack.price)} / kotak</option>)}<option value="unknown">Belum tahu, butuh saran</option></select></div><div class="field"><label for="lokasi">Lokasi acara</label><input id="lokasi" name="lokasi" type="text" autocomplete="address-level2" placeholder="Kota atau area acara" required /></div><div class="field field-wide"><label for="catatan">Catatan tambahan <span>(opsional)</span></label><textarea id="catatan" name="catatan" rows="3" placeholder="Pilihan menu, alergi, atau kebutuhan khusus"></textarea></div></div><button class="button button-sun submit-button" type="submit">Lanjutkan ke WhatsApp</button><p class="form-disclaimer">Ringkasan kebutuhan dibuka di WhatsApp. Tidak ada pembayaran atau booking otomatis.</p><p class="form-status" data-form-status role="status" aria-live="polite"></p><noscript><p>Aktifkan JavaScript untuk mengirim ringkasan formulir, atau <a href={whatsapp}>hubungi admin langsung melalui WhatsApp</a>.</p></noscript></form>
      </section>
    </main>
    <footer class="site-footer"><div class="footer-main"><a class="wordmark" href={base}><span class="brand-mark" aria-hidden="true">kb.</span><span>Kotak Berkah<span class="brand-sub">Catering</span></span></a><p>Rasa Rumah,<br />Untuk Acara Spesialmu.</p><div><a href="https://wa.me/6282268116531" target="_blank" rel="noopener noreferrer">WhatsApp admin</a><a href="tel:+6282268116531">+62 822-6811-6531</a><a href="mailto:hello@kotakberkah.id">hello@kotakberkah.id</a></div><div><a href="#paket">Paket Menu</a><a href="#portfolio">Inspirasi acara</a><a href="#form">Konsultasi Gratis</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Kotak Berkah Catering</span><span>Jabodetabek & Bandung</span></div><details class="photo-credits"><summary>Tentang foto di halaman ini</summary><p>Foto stok digunakan sebagai ilustrasi makanan, kemasan, bahan, dan suasana acara. Bukan dokumentasi produk atau pelanggan Kotak Berkah.</p><ul>{photos.map((photo) => <li><a href={photo.source} target="_blank" rel="noopener noreferrer">{photo.alt}</a> · {photo.credit}</li>)}</ul></details></footer>
    <a class="mobile-order" href="#form"><span>Siapkan acara Anda</span><strong>Konsultasi catering</strong></a>
    <script>import '../scripts/landing';</script>
  </body>
</html>
